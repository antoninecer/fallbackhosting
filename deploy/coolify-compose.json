{
  "services": {
    "coolify": {
      "container_name": "coolify",
      "restart": "unless-stopped",
      "working_dir": "/var/www/html",
      "extra_hosts": [
        "host.docker.internal:host-gateway"
      ],
      "expose": [
        "${APP_PORT:-8000}",
        "6001",
        "6002"
      ],
      "networks": {
        "coolify": {
          "aliases": [
            "coolify-realtime"
          ]
        }
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        }
      },
      "image": "coollabsio/coolify@sha256:7c54f42d64c0d20fed4a8f4561df9018a561fecba9931ed3f64a4f3e0d34a3be",
      "volumes": [
        {
          "type": "bind",
          "source": "/data/coolify/source/.env",
          "target": "/var/www/html/.env",
          "read_only": true
        },
        "/data/coolify/ssh:/var/www/html/storage/app/ssh",
        "/data/coolify/applications:/var/www/html/storage/app/applications",
        "/data/coolify/databases:/var/www/html/storage/app/databases",
        "/data/coolify/services:/var/www/html/storage/app/services",
        "/data/coolify/backups:/var/www/html/storage/app/backups",
        "/data/coolify/images:/var/www/html/storage/app/images"
      ],
      "environment": [
        "APP_ENV=${APP_ENV:-production}",
        "PHP_MEMORY_LIMIT=${PHP_MEMORY_LIMIT:-256M}",
        "PHP_FPM_PM_CONTROL=${PHP_FPM_PM_CONTROL:-dynamic}",
        "PHP_FPM_PM_START_SERVERS=${PHP_FPM_PM_START_SERVERS:-1}",
        "PHP_FPM_PM_MIN_SPARE_SERVERS=${PHP_FPM_PM_MIN_SPARE_SERVERS:-1}",
        "PHP_FPM_PM_MAX_SPARE_SERVERS=${PHP_FPM_PM_MAX_SPARE_SERVERS:-10}",
        "PUSHER_BACKEND_PORT=${PUSHER_BACKEND_PORT:-6001}"
      ],
      "env_file": [
        "/data/coolify/source/.env"
      ],
      "ports": [
        "127.0.0.1:8000:8080",
        "127.0.0.1:6001:6001",
        "127.0.0.1:6002:6002"
      ],
      "healthcheck": {
        "test": "curl --fail http://127.0.0.1:8080/api/health && curl --fail http://127.0.0.1:${PUSHER_BACKEND_PORT:-6001}/up || exit 1",
        "interval": "5s",
        "retries": 24,
        "start_period": "1m",
        "timeout": "2s"
      },
      "mem_limit": "1536m",
      "cpus": 1.0,
      "pids_limit": 512,
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "labels": {
        "io.fallback.managed": "true",
        "io.fallback.app": "coolify-control"
      }
    },
    "postgres": {
      "image": "postgres@sha256:f7d23353e1b15400d22ebe31189f4d314b87a4c129cc400c8c2d8d4ca127bf81",
      "container_name": "coolify-db",
      "restart": "unless-stopped",
      "networks": [
        "coolify"
      ],
      "volumes": [
        "coolify-db:/var/lib/postgresql/data"
      ],
      "environment": {
        "POSTGRES_USER": "${DB_USERNAME}",
        "POSTGRES_PASSWORD": "${DB_PASSWORD}",
        "POSTGRES_DB": "${DB_DATABASE:-coolify}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U ${DB_USERNAME}",
          "-d",
          "${DB_DATABASE:-coolify}"
        ],
        "interval": "5s",
        "retries": 10,
        "timeout": "2s"
      },
      "mem_limit": "512m",
      "cpus": 0.5,
      "pids_limit": 256,
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "labels": {
        "io.fallback.managed": "true",
        "io.fallback.app": "coolify-control"
      }
    },
    "redis": {
      "image": "redis@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499",
      "container_name": "coolify-redis",
      "restart": "unless-stopped",
      "networks": [
        "coolify"
      ],
      "command": "redis-server --save 20 1 --loglevel warning --requirepass ${REDIS_PASSWORD}",
      "environment": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD}"
      },
      "volumes": [
        "coolify-redis:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "REDISCLI_AUTH=\"$REDIS_PASSWORD\" redis-cli ping | grep -qx PONG"
        ],
        "interval": "5s",
        "retries": 10,
        "timeout": "2s"
      },
      "mem_limit": "256m",
      "cpus": 0.25,
      "pids_limit": 128,
      "logging": {
        "driver": "local",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "labels": {
        "io.fallback.managed": "true",
        "io.fallback.app": "coolify-control"
      }
    }
  },
  "networks": {
    "coolify": {
      "name": "coolify",
      "driver": "bridge",
      "attachable": true,
      "labels": {
        "io.fallback.app": "coolify-control"
      }
    }
  },
  "volumes": {
    "coolify-db": {
      "name": "coolify-db",
      "labels": {
        "io.fallback.app": "coolify-control"
      }
    },
    "coolify-redis": {
      "name": "coolify-redis",
      "labels": {
        "io.fallback.app": "coolify-control"
      }
    }
  }
}
