[Unit]
Description=FallbackHosting fixed demo export backup and publication
Requires=fallback-publication-demo.socket
After=network-online.target fallback-publication-demo.socket
Wants=network-online.target

[Service]
Type=simple
User=fallback-agent
Group=fallback-agent
Sockets=fallback-publication-demo.socket
WorkingDirectory=/var/lib/fallback-publication-demo/code
ExecStart=/usr/bin/python3 -m standby.publish_service --policy /var/lib/fallback-publication-demo/policy.json
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/fallback-agent/.ssh
ReadWritePaths=/var/lib/fallback-publication-demo/runtime /var/www/fallback-standby-demo
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
MemoryMax=256M
CPUQuota=40%
TasksMax=32
TimeoutStopSec=240
UMask=0077

[Install]
WantedBy=multi-user.target
